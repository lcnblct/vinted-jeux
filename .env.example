# Copie ce fichier en .env et remplis tes tokens
# cp .env.example .env

# === Telegram (recommandé, gratuit, fiable) ===
# 1. Crée un bot via @BotFather sur Telegram -> récupère le token
# 2. Chaque personne envoie un message au bot, puis :
#    curl https://api.telegram.org/bot<TOKEN>/getUpdates  -> récupère chat_id
# Pour plusieurs destinataires (dev + destinataire), sépare par virgule:
# TELEGRAM_CHAT_ID=123456789,987654321
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# === WhatsApp gratuit via CallMeBot ===
# 1. Ajoute +34 644 10 55 84 à tes contacts WhatsApp (nom: CallMeBot)
# 2. Envoie ce message exact sur WhatsApp à ce numéro: "I allow callmebot to send me messages"
# 3. Tu reçois un apikey en retour (ex: 123456). Colle-le ci-dessous.
# 4. Phone = ton numéro complet avec +33 (ex: +33612345678)
WHATSAPP_PHONE=
WHATSAPP_APIKEY=

# === ntfy.sh (fallback gratuit sans numéro) ===
# Topic secret ex: vinted-paris-xyz123-tire-au-sort
# Tu reçois sur https://ntfy.sh/<topic> ou app mobile ntfy (Android/iOS)
NTFY_TOPIC=

# === Discord ===
# Crée un webhook dans ton serveur : Paramètres serveur -> Intégrations -> Webhooks -> Copier URL
DISCORD_WEBHOOK_URL=

# === OpenRouter — LLM vision anti faux positifs (Qwen 3.7 Flash) ===
# Filtre les annonces incomplètes / accessoires / mauvais jeu avant notification
# Modèle: qwen/qwen3.7-flash (text+image+video->text) — ~$0.00004/appel
# Obtenir clé: https://openrouter.ai/keys → OPENROUTER_API_KEY, aussi en secret GH:
#   gh secret set OPENROUTER_API_KEY
# Optionnel: OPENROUTER_MODEL=qwen/qwen3.7-flash (default) / OPENROUTER_BASE_URL
# Si vide → filtre désactivé (fail-open, on notifie tout ce qui passe les filtres classiques)
OPENROUTER_API_KEY=
# OPENROUTER_MODEL=qwen/qwen3.7-flash
# OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# === Optionnel ===
# POLL_INTERVAL=60
